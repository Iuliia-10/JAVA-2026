<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Password Validation Suite">

    <!-- Сьюта Smoke (1 позитивный + 1 негативный) -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="PasswordValidationPositiveTest"/>
            <class name="PasswordValidationNegativeTest"/>
        </classes>
    </test>

    <!-- Сьюта Regression (все варианты невалидных тестов) -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="PasswordValidationNegativeTest"/>
        </classes>
    </test>

</suite>